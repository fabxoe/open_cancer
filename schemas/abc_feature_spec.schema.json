{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabxoe/open_cancer/schemas/abc_feature_spec.schema.json",
  "title": "ABC fitted feature specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_feature_spec_sha256", "fold_sha256", "class_labels", "class_order_sha256", "abc_feature_names_sha256", "abc_output_dimension", "families"],
  "properties": {
    "base_feature_spec_sha256": {"$ref": "#/$defs/sha256"},
    "fold_sha256": {"$ref": "#/$defs/sha256"},
    "class_labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "class_order_sha256": {"$ref": "#/$defs/sha256"},
    "abc_feature_names_sha256": {"$ref": "#/$defs/sha256"},
    "abc_output_dimension": {"type": "integer", "minimum": 1},
    "families": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/family"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version", "license", "sha256", "uri"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "uri": {"type": ["string", "null"]}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_version", "enabled", "output_dimension", "feature_names_sha256", "fit_scope", "external_knowledge"],
      "properties": {
        "definition_version": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "output_dimension": {"type": "integer", "minimum": 1},
        "feature_names_sha256": {"$ref": "#/$defs/sha256"},
        "fit_scope": {"enum": ["stateless", "fold_train"]},
        "external_knowledge": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knowledge"}}]}
      }
    }
  }
}
