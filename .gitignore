# macOS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Python
.python-version.local
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Generated data
data/processed/*
!data/processed/.gitkeep

# Externally licensed data (e.g. COSMIC) - not redistributable
data/external/

# EXP-012 output contains raw COSMIC gene symbols; license/redistribution
# status not yet confirmed with the team (see Issue #12). Keep local until
# cleared.
reports/exp012_feature_analysis/

# Large experiment artifacts
models/*
!models/.gitkeep
oof/*
!oof/.gitkeep
preds/*
!preds/.gitkeep

# Local logs and temporary files
logs/
tmp/
temp/
*.log

# Large report and archive formats
reports/**/*.pdf
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.zip
reports/**/*.tar
reports/**/*.gz

# Reproducibility bundles are stored as GitHub Release assets.
reproducibility/**/*.pt
reproducibility/**/*.pth
reproducibility/**/*.ckpt
reproducibility/**/*.pkl
reproducibility/**/*.joblib
reproducibility/**/*.bin
reproducibility/**/*.zip
reproducibility/**/*.tar
reproducibility/**/*.gz
